# ==========================================
# RADAR DE LICITAÇÕES TI - Variáveis de ambiente
# ==========================================
# Copie este arquivo para .env e preencha os valores

# Telegram Bot
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Portal da Transparência (gratuito: portaldatransparencia.gov.br/api-de-dados/cadastrar-email)
PORTAL_TRANSPARENCIA_API_KEY=

# Email SMTP 
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Dashboard Auth (gere senhas com: python -c "import bcrypt; print(bcrypt.hashpw(b'sua_senha', bcrypt.gensalt()).decode())")
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
ADMIN_NAME=Administrador
ADMIN_EMAIL=

# Chave para cookies do Streamlit Authenticator (gere com: python -c "import secrets; print(secrets.token_hex(32))")
# OBRIGATÓRIO em produção - o sistema recusa iniciar com o valor padrão
COOKIE_KEY=chave-secreta-alterar-em-producao

# CORS — origens permitidas para a API REST (separadas por vírgula)
# Em produção, NUNCA use *
CORS_ORIGINS=http://localhost:8501,http://localhost:3000

# API Keys para autenticação da API REST (separadas por vírgula)
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Se vazio, API aceita todas as requisições (modo dev)
API_KEYS=

# Ambiente: development | staging | production
ENV=development

# Sentry — Monitoramento de erros em produção
# Criar projeto em https://sentry.io e copiar DSN
SENTRY_DSN=
SENTRY_TRACES_RATE=0.1
APP_VERSION=2.0.0

# PostgreSQL (opcional — se vazio, usa SQLite)
# Em produção, recomendado para escala e concorrência
DATABASE_URL=
# Formato: postgresql://user:password@host:port/dbname

# JWT — Tokens de autenticação para API/mobile
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_EXPIRE_HOURS=24

# Rate Limiting — Proteção contra abuso da API
# Formato: "requisições/período" (ex: 60/minute, 1000/hour)
RATE_LIMIT=60/minute

# Slack — Webhook para notificações
# Criar em: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=

# Discord — Webhook para notificações
# Criar em: Configurações do canal > Integrações > Webhooks
DISCORD_WEBHOOK_URL=
